CRYPTO_OI_THRESHOLD=15.0
CRYPTO_PRICE_QUIET=5.0
CRYPTO_ENABLE_FUTURES=true
CRYPTO_ENABLE_BREAKOUT=true
CRYPTO_ENABLE_NEWS=true

# =====================================================================
# FUTBOL BOTI
# =====================================================================
FOOTBALL_TELEGRAM_BOT_TOKEN=8717258739:AAE6o3vHAksI8J5XcPPPfcSGu1x9Pp7ojZo
FOOTBALL_TELEGRAM_CHANNEL_ID=@football_ballist
FOOTBALL_INTERVAL_MINUTES=240

# Bo'sh qoldirilsa — barcha ligalar (APL, La Liga, Serie A, Bundesliga, Ligue 1, UCL,
# O'zbekiston Superligasi). Faqat ba'zilarini xohlasangiz, ID'larni vergul bilan yozing
# (ID'lar sportsdb_api.py'dagi LEAGUES ro'yxatida ko'rinadi), masalan:
# FOOTBALL_LEAGUES=4328,4794
FOOTBALL_LEAGUES=

FOOTBALL_DAYS_BACK=2
FOOTBALL_DAYS_FORWARD=2
FOOTBALL_POST_DELAY_SECONDS=2.5
FOOTBALL_NEWS_COUNT=5
FOOTBALL_ENABLE_RESULTS=true
FOOTBALL_ENABLE_FIXTURES=true
FOOTBALL_ENABLE_NEWS=true
