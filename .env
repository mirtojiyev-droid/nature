# Bu faylni nusxalab ".env" nomi bilan saqlang va o'z qiymatlaringizni yozing.
# .env faylni hech qachon boshqalarga bermang yoki GitHub'ga yuklamang!
#
# Har bir bot MUSTAQIL: agar bironta bot uchun TELEGRAM_CHANNEL_ID bo'sh qoldirilsa,
# hub o'sha botni shunchaki ishga tushirmaydi (xato bermaydi) — masalan hozircha
# faqat 2 ta bot kerak bo'lsa, uchinchisining CHANNEL_ID qatorini bo'sh qoldiring
# yoki butunlay o'chirib tashlang.
#
# BITTA umumiy bot tokenidan foydalanish MUMKIN (bitta bot 3 xil kanalga admin qilib
# qo'yilsa) — shunda faqat pastdagi umumiy TELEGRAM_BOT_TOKEN'ni to'ldiring va har bir
# botning o'z *_TELEGRAM_BOT_TOKEN qatorini bo'sh qoldiring. Xavfsizroq variant — har
# biriga @BotFather'dan alohida bot yaratish (flood-limit muammolarini kamaytiradi).

# (Ixtiyoriy) Barcha botlar uchun standart bot tokeni — agar quyida botga xos token
# berilmasa, shu ishlatiladi.
TELEGRAM_BOT_TOKEN=
COINGECKO_API_KEY=CG-dsvUzFTpPsM19GWwLvuoHR3U
# =====================================================================
# TABIAT BOTI
# =====================================================================
NATURE_TELEGRAM_BOT_TOKEN=8940801538:AAGiTAFYlnSWjP17c4n83HgG-9IOruUEYE0
NATURE_TELEGRAM_CHANNEL_ID=@naturenaturee
NATURE_INTERVAL_MINUTES=30
NATURE_TRANSLATE_TO_UZBEK=true
NATURE_POST_PHOTO_TOO=true

# https://www.pexels.com/api/ saytidan bepul olinadigan API kalit (tabiat boti uchun)
PEXELS_API_KEY=your_pexels_api_key_here
# (Ixtiyoriy) https://pixabay.com/api/docs/ saytidan bepul olinadigan API kalit
PIXABAY_API_KEY=CU8DLQKjH8pu12YHJtuK1SiWacG7H2p1lOvtcjROK6UZ3SGKeJHFxmgL

