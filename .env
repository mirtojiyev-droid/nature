# Bu faylni nusxalab ".env" nomi bilan saqlang va o'z qiymatlaringizni yozing.
# .env faylni hech qachon boshqalarga bermang yoki GitHub'ga yuklamang!
#
# Har bir bot MUSTAQIL: agar bironta bot uchun TELEGRAM_CHANNEL_ID bo'sh qoldirilsa,
# hub o'sha botni shunchaki ishga tushirmaydi (xato bermaydi) — masalan hozircha
# faqat 2 ta bot kerak bo'lsa, uchinchisining CHANNEL_ID qatorini bo'sh qoldiring
# yoki butunlay o'chirib tashlang.
#
# BITTA umumiy bot tokenidan foydalanish MUMKIN (bitta bot 3 xil kanalga admin qilib
# qo'yilsa) — shunda faqat pastdagi umumiy TELEGRAM_BOT_TOKEN'ni to'ldiring va har bir
# botning o'z *_TELEGRAM_BOT_TOKEN qatorini bo'sh qoldiring. Xavfsizroq variant — har
# biriga @BotFather'dan alohida bot yaratish (flood-limit muammolarini kamaytiradi).

# (Ixtiyoriy) Barcha botlar uchun standart bot tokeni — agar quyida botga xos token
# berilmasa, shu ishlatiladi.
TELEGRAM_BOT_TOKEN=

# Bir vaqtning o'zida nechta bot ISHLASHI mumkinligi (operativ xotirani nazorat qilish
# uchun). Standart: 1 — botlar hech qachon bir vaqtda ishlamaydi, birin-ketin navbat
# bilan ishlaydi (Render/Railway kabi arzon, kam xotirali (512MB-1GB) tariflar uchun
# XAVFSIZ va TAVSIYA ETILADI — aks holda "out of memory" xatosiga uchrashingiz mumkin,
# ayniqsa tabiat boti 4K video qayta kodlayotganda boshqa bot ham ishga tushib qolsa).
# Agar serveringizda operativ xotira yetarli bo'lsa (2GB+), 2 yoki 3'ga oshirishingiz
# mumkin — shunda botlar bir-birini kutmasdan tezroq ishlaydi.
HUB_MAX_CONCURRENT_JOBS=1

# =====================================================================
# TABIAT BOTI
# =====================================================================
NATURE_TELEGRAM_BOT_TOKEN=8940801538:AAGiTAFYlnSWjP17c4n83HgG-9IOruUEYE0
NATURE_TELEGRAM_CHANNEL_ID=@naturenaturee
NATURE_INTERVAL_MINUTES=30
NATURE_TRANSLATE_TO_UZBEK=true
NATURE_POST_PHOTO_TOO=true
# Kam operativ xotirali serverlar uchun (masalan Render'ning 512MB tariflari) —
# "out of memory" xatosi bo'lsa, buni 1280'ga tushiring. Standart bu yerda ehtiyot
# yuzasidan 1920 qilib qo'yilgan (512MB'da 4K encoding xavfli); agar serveringizda
# operativ xotira ko'proq bo'lsa (2GB+), 3840 (4K)ga oshirishingiz mumkin.
NATURE_MAX_VIDEO_QUALITY_PX=1920

# https://www.pexels.com/api/ saytidan bepul olinadigan API kalit (tabiat boti uchun)
PEXELS_API_KEY=CU8DLQKjH8pu12YHJtuK1SiWacG7H2p1lOvtcjROK6UZ3SGKeJHFxmgL
# (Ixtiyoriy) https://pixabay.com/api/docs/ saytidan bepul olinadigan API kalit
PIXABAY_API_KEY=55090643-d740acb15ea9fe4d0164bdf55

# =====================================================================
# KRIPTO BOTI
# Ma'lumot manbasi: CoinGecko (Binance emas — Binance.com AQSh va ba'zi bulut
# serverlari IP'laridan kirishni geografik jihatdan bloklagani uchun almashtirildi).
# Shuning uchun bu yerda fyuchers sozlamalari (funding/OI/long-short) YO'Q — CoinGecko
# bunday ma'lumotni umuman bermaydi.
#
# (Ixtiyoriy, lekin TAVSIYA ETILADI) CoinGecko'da bepul ro'yxatdan o'ting
# (https://www.coingecko.com/en/api/pricing — karta talab qilinmaydi) va "Demo" API
# kalitni shu yerga qo'ying — so'rov chastotasi 5-15/daqiqadan 30/daqiqaga ko'tariladi,
# bot sezilarli tezroq ishlaydi. Bo'sh qoldirilsa ham botta ishlayveradi, faqat sekinroq.
COINGECKO_API_KEY=CG-dsvUzFTpPsM19GWwLvuoHR3U
# =====================================================================
CRYPTO_TELEGRAM_BOT_TOKEN=8949964705:AAF59z85BbzWTjaWDeuVlB8W94Sp_UKJYy8
CRYPTO_TELEGRAM_CHANNEL_ID=@Kripto_bozor_new
CRYPTO_INTERVAL_MINUTES=60

CRYPTO_TOP_N=10
CRYPTO_MIN_VOLUME=1000000
CRYPTO_POST_DELAY_SECONDS=2.5
CRYPTO_NEWS_COUNT=5
# CoinGecko so'rov chastotasi cheklangani uchun standart qiymat Binance versiyasidagidan
# (60) ancha kichraytirilgan — aks holda bitta ishga tushirish juda uzoq davom etadi.
CRYPTO_BREAKOUT_SCAN_SIZE=20
CRYPTO_BREAKOUT_TOP_N=5
CRYPTO_VOLUME_MULTIPLIER=3.0
CRYPTO_ENABLE_BREAKOUT=true
CRYPTO_ENABLE_NEWS=true
# Yangiliklar sarlavhasi CoinDesk/Cointelegraph'dan ingliz tilida keladi — standart
# bo'yicha o'zbek tiliga tarjima qilinadi.
CRYPTO_TRANSLATE_TO_UZBEK=true

# =====================================================================
# FUTBOL BOTI
# =====================================================================
FOOTBALL_TELEGRAM_BOT_TOKEN=8717258739:AAE6o3vHAksI8J5XcPPPfcSGu1x9Pp7ojZo
FOOTBALL_TELEGRAM_CHANNEL_ID=@football_ballist
# Endi soatlik "qiziqarli fakt" posti ham bor bo'lgani uchun standart har soatga
# tushirildi (natija/fixture/yangilik takrorlanmaydi — state.py orqali kuzatiladi,
# shuning uchun tez-tez tekshirish endi xavfsiz).
FOOTBALL_INTERVAL_MINUTES=60

# Bo'sh qoldirilsa — barcha ligalar (APL, La Liga, Serie A, Bundesliga, Ligue 1, UCL,
# O'zbekiston Superligasi). Faqat ba'zilarini xohlasangiz, ID'larni vergul bilan yozing
# (ID'lar sportsdb_api.py'dagi LEAGUES ro'yxatida ko'rinadi), masalan:
# FOOTBALL_LEAGUES=4328,4794
FOOTBALL_LEAGUES=

FOOTBALL_DAYS_BACK=2
FOOTBALL_DAYS_FORWARD=2
FOOTBALL_POST_DELAY_SECONDS=2.5
FOOTBALL_NEWS_COUNT=5
FOOTBALL_ENABLE_RESULTS=true
FOOTBALL_ENABLE_FIXTURES=true
FOOTBALL_ENABLE_NEWS=true

# Har ishga tushganda (standart bo'yicha har soatda) bitta qiziqarli, Wikipedia manbali
# futbol fakti joylaydi ("Bilasizmi?" posti).
FOOTBALL_ENABLE_TRIVIA=true

# Kuniga taxminan 2 marta mashhur futbolchi haqida (hozirgi klubi + tarjimai holi,
# Wikipedia'dan) alohida post joylaydi. FOOTBALL_SPOTLIGHT_MIN_HOURS — ikkita spotlight
# posti orasidagi minimal soat (standart 11 — soatlik tekshiruvda kuniga ~2 marta chiqadi).
FOOTBALL_ENABLE_SPOTLIGHT=true
FOOTBALL_SPOTLIGHT_MIN_HOURS=11

# Trivia va spotlight matnlari (Wikipedia'dan inglizcha kelgan) o'zbek tiliga
# tarjima qilinsinmi. Natija/fixture/yangilik captionlariga bu ta'sir qilmaydi
# (ular allaqachon qo'lda o'zbekcha yozilgan).
FOOTBALL_TRANSLATE_TO_UZBEK=true

# =====================================================================
# YOUTUBE-REPOST BOTI
# =====================================================================
# YouTube'ning rasmiy TREND jadvalidan (youtube.com/feed/trending bilan bir xil
# manba) video topib, Telegram kanalga yuklab-joylaydi. Batafsil: bots/youtube/README.md

# console.cloud.google.com -> "YouTube Data API v3"ni yoqib, shu yerdan API kalit oling.
YOUTUBE_API_KEY=AIzaSyD4HucmHflYxl8WXyVa7VxHKCO0YIt_ZZ8

YOUTUBE_TELEGRAM_BOT_TOKEN=8291749999:AAFvcEb9-PsOYKddt5z-bP8UGHoquvKCXz0
YOUTUBE_TELEGRAM_CHANNEL_ID=@youtube2telegram
# Standart: har 2 soatda (so'ralganidek).
YOUTUBE_INTERVAL_MINUTES=120

YOUTUBE_REGION_CODE=UZ
# Trend jadvali shu kategoriya bilan cheklanadi. 10 = Music. Boshqa foydali ID'lar:
# 24 = Entertainment, 23 = Comedy. To'liq ro'yxat: bots/youtube/categories.py
YOUTUBE_VIDEO_CATEGORY_ID=10
YOUTUBE_EXCLUDE_CATEGORY_IDS=20
YOUTUBE_EXCLUDE_KEYWORDS=roblox,gameplay,minecraft,fortnite,gta,pubg,free fire
YOUTUBE_MAX_RESULTS=100
YOUTUBE_MIN_VIEWS=100000
YOUTUBE_MAX_AGE_HOURS=168
YOUTUBE_MAX_DURATION_SEC=180
# short — faqat Shorts, long — faqat uzun videolar (Shorts'siz), both — ikkalasi.
YOUTUBE_VIDEO_LENGTH_MODE=long
YOUTUBE_MAX_LONG_DURATION_SEC=900

# Bitta ishga tushirishda nechta video joylanadi (uchta turkumga bo'lingan holda).
YOUTUBE_POSTS_TRENDING=1
YOUTUBE_POSTS_MOST_VIEWED=2
YOUTUBE_POSTS_NEWEST=2
YOUTUBE_MAX_POSTS_PER_RUN=5
YOUTUBE_MIN_UZBEK_PER_RUN=1
YOUTUBE_PREFERRED_LANGUAGES=en,ru,uz
YOUTUBE_AVOID_LANGUAGES=hi
YOUTUBE_EXTRA_REGION_CODES=US,RU

# YouTube "sign in to confirm you're not a bot" xatosi chiqsa, brauzerdan eksport
# qilingan cookies.txt fayl yo'lini shu yerga yozing (ixtiyoriy).
YOUTUBE_YTDLP_COOKIES_FILE=
