# Bu faylni nusxalab ".env" nomi bilan saqlang va o'z qiymatlaringizni yozing.
# .env faylni hech qachon boshqalarga bermang yoki GitHub'ga yuklamang!

# @BotFather'dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHere

# Kanal username (masalan @mening_kanalim) yoki -100 bilan boshlanuvchi kanal ID
TELEGRAM_CHANNEL_ID=@mening_tabiat_kanalim

# https://www.pexels.com/api/ saytidan bepul olinadigan API kalit
PEXELS_API_KEY=your_pexels_api_key_here

# (Ixtiyoriy, lekin tavsiya etiladi) https://pixabay.com/api/docs/ saytidan bepul
# olinadigan API kalit — Pexels'ga qo'shimcha ikkinchi manba sifatida ishlatiladi va
# video topilish ehtimolini sezilarli oshiradi. Bo'sh qoldirsangiz, bot faqat
# Pexels bilan ishlashda davom etadi (xato bermaydi).
PIXABAY_API_KEY=your_pixabay_api_key_here

# Caption'larni o'zbek tiliga tarjima qilishni yoqish/o'chirish (true/false)
TRANSLATE_TO_UZBEK=true

# Har bir postda video (asosiy kontent) dan tashqari rasm ham topilsa, uni ham
# joylash (true/false). false qilsangiz, faqat video joylanadi.
POST_PHOTO_TOO=true

# scheduler.py uchun: har necha daqiqada bir post joylansin (standart: 30 daqiqa =
# kuniga ~48 ta post, bugungi mavzuning turli qirralari haqida)
POST_INTERVAL_MINUTES=30
