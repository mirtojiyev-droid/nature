; systemd xizmat fayli — botni VPS'da doimiy (24/7) ishlab turadigan qilib qo'yadi,
; server qayta yoqilganda yoki bot qulab tushganda avtomatik qayta ishga tushiradi.
;
; O'rnatish (README.md'dagi "VPS'ga joylash" bo'limiga qarang):
;   sudo cp nature-bot.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;   sudo systemctl enable nature-bot
;   sudo systemctl start nature-bot
;
; Diqqat: quyidagi User, WorkingDirectory va ExecStart yo'llarini o'zingiznikiga moslang.

[Unit]
Description=Tabiat kanali uchun avtomatik post bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/nature_channel_bot
ExecStart=/home/YOUR_USERNAME/nature_channel_bot/venv/bin/python scheduler.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
